---
interface Props {
  title: string;
  text?: string;
  ctaLabel: string;
  ctaHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title,
  text,
  ctaLabel,
  ctaHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<div class="cta card" data-reveal>
  <div class="cta-text">
    <h3>{title}</h3>
    {text && <p class="muted">{text}</p>}
  </div>

  <div class="cta-actions">
    <a class="btn btn-primary" href={ctaHref}>{ctaLabel}</a>
    {
      secondaryLabel && secondaryHref && (
        <a class="btn btn-ghost" href={secondaryHref}>
          {secondaryLabel}
        </a>
      )
    }
  </div>
</div>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 44px 46px;
    border-radius: 22px;
    background: linear-gradient(
      120deg,
      color-mix(in srgb, var(--accent) 18%, var(--surface)),
      color-mix(in srgb, var(--warm) 12%, var(--surface))
    );
  }

  h3 {
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    margin-bottom: 8px;
  }

  .cta-text p {
    margin: 0;
    max-width: 52ch;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 640px) {
    .cta {
      padding: 32px 24px;
    }
  }
</style>
