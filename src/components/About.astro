---
const points = [
  'We pick problems we actually care about.',
  'Small team, no hand-offs, everyone ships code.',
  'We leave the repo better than we found it.',
];
---

<section class="section" id="about">
  <div class="container about">
    <div>
      <span class="eyebrow">About</span>
      <h2>Four people, one weekend, one working product</h2>
      <p class="muted">
        We started as strangers at a Friday-night team mixer and kept entering
        together. We like small scope, fast feedback, and demos that run live —
        no smoke, no mockups pretending to be software.
      </p>
    </div>

    <ul class="points">
      {points.map((point) => (
        <li>
          <span class="dot"></span>
          {point}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }

  h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.3rem);
    max-width: 22ch;
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .points li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.97rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
  }

  @media (max-width: 820px) {
    .about {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
