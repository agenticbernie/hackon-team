---
const members = [
  { name: 'Bernie', role: 'Frontend & design systems', initials: 'BE' },
  { name: 'Priya', role: 'Backend & data', initials: 'PR' },
  { name: 'Marco', role: 'Product & story', initials: 'MA' },
  { name: 'Yuki', role: 'Infra & demos', initials: 'YU' },
];
---

<section class="section" id="team">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Team</span>
      <h2>The people behind the demo</h2>
    </div>

    <div class="grid">
      {members.map((member) => (
        <article class="card member">
          <span class="avatar">{member.initials}</span>
          <h3>{member.name}</h3>
          <p class="muted">{member.role}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 20px;
  }

  .member {
    text-align: center;
  }

  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: 14px;
    border-radius: 50%;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #070910;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
  }

  .member h3 {
    font-size: 1.05rem;
    margin-bottom: 2px;
  }

  .member p {
    margin: 0;
    font-size: 0.9rem;
  }
</style>
