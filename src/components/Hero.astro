---
const focus = [
  'Agentic AI',
  'Web3',
  'Autonomous infrastructure',
  'AI-native products',
];
---

<section class="hero" id="home">
  <div class="container hero-inner">
    <img
      class="crest"
      src="/brand/logo-mark.png"
      alt="HackOn Team"
      width="88"
      height="88"
    />

    <p class="kicker">Independent builder organization · Vietnam</p>

    <h1>HackOn Team</h1>
    <p class="tagline">Ignite. Work. Ship. Repeat.</p>

    <p class="statement">
      An independent builder organization exploring Agentic AI, Web3, and
      emerging infrastructure.
    </p>

    <p class="desc muted">
      We build products, experiment with emerging technologies, and create
      environments where builders learn by shipping real things.
    </p>

    <div class="actions">
      <a class="btn btn-primary" href="#projects">Explore what we're building</a>
      <a class="btn btn-ghost" href="#contact">Get in touch</a>
    </div>

    <ul class="focus">
      {focus.map((item) => <li class="chip">{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 132px 0 112px;
    text-align: center;
    overflow: hidden;
  }

  .hero::before,
  .hero::after {
    content: "";
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
  }

  .hero::before {
    top: -34%;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 700px;
    background: radial-gradient(closest-side, rgba(0, 168, 255, 0.2), transparent 72%);
  }

  .hero::after {
    top: 4%;
    left: 50%;
    transform: translateX(-50%) translateX(190px);
    width: 440px;
    height: 380px;
    background: radial-gradient(closest-side, rgba(255, 140, 0, 0.16), transparent 70%);
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .crest {
    width: 88px;
    height: 88px;
    margin-bottom: 26px;
    filter: drop-shadow(0 14px 44px rgba(0, 168, 255, 0.4));
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 16px;
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 4.4rem);
    margin-bottom: 8px;
  }

  .tagline {
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 2.2vw, 1.18rem);
    letter-spacing: 0.06em;
    margin-bottom: 32px;
    background: linear-gradient(
      100deg,
      var(--warm),
      var(--core) 35%,
      var(--accent-2) 74%,
      var(--accent)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .statement {
    font-size: clamp(1.05rem, 2.4vw, 1.32rem);
    color: var(--text-dim);
    max-width: 60ch;
    margin-bottom: 14px;
  }

  .desc {
    max-width: 58ch;
    margin-bottom: 34px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
    margin-bottom: 42px;
  }

  .focus {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  /* Hero entrance sequence */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .js .hero-inner > * {
    animation: rise 0.8s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }

  .js .hero-inner > *:nth-child(1) { animation-delay: 0.04s; }
  .js .hero-inner > *:nth-child(2) { animation-delay: 0.1s; }
  .js .hero-inner > *:nth-child(3) { animation-delay: 0.16s; }
  .js .hero-inner > *:nth-child(4) { animation-delay: 0.22s; }
  .js .hero-inner > *:nth-child(5) { animation-delay: 0.28s; }
  .js .hero-inner > *:nth-child(6) { animation-delay: 0.34s; }
  .js .hero-inner > *:nth-child(7) { animation-delay: 0.4s; }
  .js .hero-inner > *:nth-child(8) { animation-delay: 0.46s; }

  @media (prefers-reduced-motion: reduce) {
    .js .hero-inner > * {
      animation: none;
    }
  }
</style>
