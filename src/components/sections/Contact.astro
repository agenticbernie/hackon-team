---
import SectionHeader from '../SectionHeader.astro';
---

<section class="section" id="contact">
  <div class="container">
    <SectionHeader
      eyebrow="Contact"
      title="Let's Build Something"
      intro="For collaborations, partnerships, projects, or general inquiries, reach out directly."
      center
    />

    <div class="channels" data-reveal>
      <a class="channel card" href="mailto:bernie@hackon.team">
        <span class="label">Email</span>
        <span class="value">bernie@hackon.team</span>
      </a>

      <a
        class="channel card"
        href="https://www.linkedin.com/in/bernieweb3"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="label">LinkedIn</span>
        <span class="value">bernieweb3<span class="ext" aria-hidden="true">↗</span></span>
      </a>
    </div>
  </div>
</section>

<style>
  .channels {
    display: grid;
    gap: 18px;
    max-width: 720px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .channels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .channel {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 26px 28px;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .channel:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .value {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 1.12rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .channel:hover .value {
    color: var(--accent-2);
  }

  .ext {
    font-size: 0.85rem;
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .channel:hover {
      transform: none;
    }
  }
</style>
